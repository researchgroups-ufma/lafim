/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # allow-popups (e nao same-origin) porque o /admin abre o popup de OAuth
  # no Worker: com same-origin o navegador corta o window.opener do popup e
  # o Decap nunca recebe o token
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  X-XSS-Protection: 0

# Arquivos do build com hash no nome: o conteúdo nunca muda sob a mesma URL,
# então o navegador pode guardar por 1 ano sem revalidar.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
